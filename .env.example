# Copie para .env e carregue no servidor (ex.: node --env-file=.env server.js)
PORT=3000
SITE_URL=https://www.seudominio.com.br
ADMIN_EMAIL=voce@seudominio.com.br
ADMIN_PASSWORD=troque-por-uma-senha-longa     # só usada na 1ª execução; depois remova
# DATA_DIR=/var/data/ogeid                    # onde ficam banco e uploads (use disco persistente!)
# APP_SECRET=                                 # opcional; se vazio é gerado em data/.secret
# TRUST_PROXY=1                               # ligue se estiver atrás de Nginx/Caddy/Cloudflare
# NODE_ENV=production                         # cookie de sessão "Secure" (exige HTTPS)
# NOTIFY_WEBHOOK_URL=                         # Zapier/Make/n8n: recebe um POST a cada nova solicitação
# NOTIFY_EMAIL_TO=                            # destino dos avisos por e-mail (veja src/lib.js → sendEmail)
# MP_ACCESS_TOKEN=                            # Mercado Pago (futuro) — veja src/payments.js
